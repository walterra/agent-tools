{
  "name": "@walterra/pi-todo-tracker",
  "version": "0.0.0",
  "description": "Todo tracker for pi coding agent - shared checklists with a live web board, across sessions and projects",
  "type": "module",
  "files": [
    "extensions",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/todo-tracker/index.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/walterra/agent-tools.git",
    "directory": "packages/pi-todo-tracker"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "todo",
    "tracker",
    "checklist",
    "web-ui"
  ],
  "author": "walterra",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0"
  }
}
